# JetPack 4.6.1: r32.7.1; change this to match /etc/nv_tegra_release.
L4T_TAG=r32.7.1
IMAGE_TAG=nano

INPUT_VIDEO=/workspace/test_video.mp4
MODEL_FILE=/workspace/yolo11n.onnx
ENGINE_CACHE=/workspace/yolo11n.nano.fp16.engine

VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=25
INFER_FPS=5

# true asks DRM to select an HDMI mode matching VIDEO_WIDTH x VIDEO_HEIGHT.
DRM_SET_MODE=true
# Leave empty for automatic selection. Fill these only if the wrong output/plane is used.
DRM_CONN_ID=
DRM_PLANE_ID=
