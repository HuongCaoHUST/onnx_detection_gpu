# Jetson Nano production image. Build this image ON the Jetson (ARM64), not on x86.
# r32.7.1 corresponds to JetPack 4.6.x / CUDA 10.2 / TensorRT 8.x.
ARG L4T_TAG=r32.7.1
FROM nvcr.io/nvidia/l4t-base:${L4T_TAG}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    cuda-cudart-dev-10-2 \
    libnvinfer-dev \
    libnvonnxparsers-dev \
    libopencv-dev \
    meson \
    ninja-build \
    pkg-config \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/src
COPY gst-template ./gst-template

RUN meson setup gst-template/build-jetson gst-template \
      --buildtype=release \
      --prefix=/opt/onnx-gst \
      -Dinference_backend=tensorrt \
    && ninja -C gst-template/build-jetson \
    && ninja -C gst-template/build-jetson install

ENV GST_PLUGIN_PATH=/opt/onnx-gst/lib/aarch64-linux-gnu/gstreamer-1.0:/opt/onnx-gst/lib/gstreamer-1.0
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu/tegra

COPY run_jetson_pipeline.sh /usr/local/bin/run-jetson-detection
RUN chmod +x /usr/local/bin/run-jetson-detection

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/run-jetson-detection"]
