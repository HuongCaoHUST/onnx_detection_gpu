# Jetson Nano production image. Build this image ON the Jetson (ARM64), not on x86.
# r32.7.1 corresponds to JetPack 4.6.x / CUDA 10.2 / TensorRT 8.x.
ARG L4T_TAG=r32.7.1
FROM nvcr.io/nvidia/l4t-base:${L4T_TAG}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libopencv-dev \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    && rm -rf /var/lib/apt/lists/*

# CUDA and TensorRT libraries are injected from the Jetson host by
# nvidia-container-runtime. The plugin itself is compiled on the host and mounted
# with the workspace because l4t-base does not expose NVIDIA development packages
# while docker build is running.
ENV GST_PLUGIN_PATH=/workspace/gst-template/build-jetson/gst-plugin
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/aarch64-linux-gnu/tegra
# Jetson/Bionic can exhaust the static TLS slots when GStreamer loads OpenCV,
# libav and OpenMP in plugin-scanner. Loading libgomp first reserves its slot.
ENV LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1

COPY run_jetson_pipeline.sh /usr/local/bin/run-jetson-detection
RUN chmod +x /usr/local/bin/run-jetson-detection

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/run-jetson-detection"]
